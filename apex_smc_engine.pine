//@version=5
indicator("Apex AI SMC Live Engine", overlay=true, max_boxes_count=500, max_lines_count=500)

// Timeframe Settings
tf_trend = input.timeframe("240", title="Trend/Zone Timeframe (4H)")
tf_entry = input.timeframe("15", title="Entry Timeframe (15m/30m)")

// 1. Multi-Timeframe High/Low for 4H Supply/Demand Detection
high_4h = request.security(syminfo.tickerid, tf_trend, ta.highest(high, 10))
low_4h  = request.security(syminfo.tickerid, tf_trend, ta.lowest(low, 10))

// 2. 15m CHoCH Detection (Change of Character)
bullish_choch = ta.crossover(close, ta.highest(high, 5)[1])
bearish_choch = ta.crossunder(close, ta.lowest(low, 5)[1])

// 3. FVG (Fair Value Gap) Detection
bullish_fvg = (low > high[2])
bearish_fvg = (high < low[2])

// 4. Session Identification (London & New York)
time_in_session = not na(time(timeframe.period, "0800-1700:23456"))
session_name = time_in_session ? "London/NY Active" : "Asian Session"

// Plot visual cues on TradingView Chart
plotshape(bullish_choch, title="Bullish CHoCH", location=location.belowbar, color=color.green, style=shape.triangleup, size=size.small)
plotshape(bearish_choch, title="Bearish CHoCH", location=location.abovebar, color=color.red, style=shape.triangledown, size=size.small)

// 5. Dynamic Webhook Alerts for Apex AI Bot
if (bullish_choch)
    alert_msg_buy = '{"symbol": "' + syminfo.ticker + '", "action": "BUY", "entry": "' + str.tostring(close, "#.#####") + '", "trend": "4H Demand Active", "structure": "15m CHoCH Confirmed", "ob": "15m Bullish OB", "fvg": "' + (bullish_fvg ? "Active FVG" : "No FVG") + '", "session": "' + session_name + '"}'
    alert(alert_msg_buy, alert.freq_once_per_bar_close)

if (bearish_choch)
    alert_msg_sell = '{"symbol": "' + syminfo.ticker + '", "action": "SELL", "entry": "' + str.tostring(close, "#.#####") + '", "trend": "4H Supply Active", "structure": "15m Bearish CHoCH", "ob": "15m Bearish OB", "fvg": "' + (bearish_fvg ? "Active FVG" : "No FVG") + '", "session": "' + session_name + '"}'
    alert(alert_msg_sell, alert.freq_once_per_bar_close)
